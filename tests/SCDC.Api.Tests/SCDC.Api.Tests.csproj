<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SCDC.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="../../docs/fixtures/text-validation.json" Link="fixtures/text-validation.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/fixtures/dm-fingerprint.json" Link="fixtures/dm-fingerprint.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../services/SCDC.Api/SCDC.Api.csproj" Aliases="global,ScdcApi" />
    <ProjectReference Include="../../services/SCDC.BuildingBlocks/SCDC.BuildingBlocks.csproj" />
    <ProjectReference Include="../../tools/SCDC.DbMigrator/SCDC.DbMigrator.csproj" />
    <ProjectReference Include="../../services/Shared/SCDC.Shared.Core/SCDC.Shared.Core.csproj" />
    <ProjectReference Include="../../services/Sample/SCDC.Sample.Api/SCDC.Sample.Api.csproj" Aliases="ScdcSample" />
    <ProjectReference Include="../../services/Identity/SCDC.Identity.Api/SCDC.Identity.Api.csproj" Aliases="IdentityApi" />
    <ProjectReference Include="../../services/Identity/SCDC.Identity.Application/SCDC.Identity.Application.csproj" />
    <ProjectReference Include="../../services/Identity/SCDC.Identity.Domain/SCDC.Identity.Domain.csproj" />
    <ProjectReference Include="../../services/Identity/SCDC.Identity.Infrastructure/SCDC.Identity.Infrastructure.csproj" />
  </ItemGroup>

</Project>
