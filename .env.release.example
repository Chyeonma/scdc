# Copy to a private .env.release file and replace every placeholder.
SCDC_DB_PASSWORD=replace-with-a-unique-database-password
SCDC_SIGNING_KEY=replace-with-a-random-signing-key-of-at-least-32-characters
SCDC_S3_ACCESS_KEY=replace-with-a-unique-storage-access-key
SCDC_S3_SECRET_KEY=replace-with-a-unique-storage-secret-key
SCDC_WEB_PORT=3000
