          "400": [
            "Common.ValidationFailed",
            "CURSOR_INVALID"
          ],
          "401": [
            "Common.Unauthorized"
          ],
          "503": [
            "AUTHORITY_UNAVAILABLE"
          ],
          "404": [
            "RESOURCE_NOT_FOUND"
          ]
        }
      },
