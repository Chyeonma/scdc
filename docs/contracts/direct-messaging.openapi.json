          "conversationId",
          "author",
          "clientMessageId",
          "sequence",
          "version",
          "content",
          "createdAt",
          "editedAt",
          "deletedAt"
        ],
        "additionalProperties": false,
        "description": "Current message. Deleted: content=null and deletedAt set. Restore unavailable: content=null, deletedAt=null and contentState=unavailable_after_restore. Never return old edited body; actor-author may explicitly edit unavailable message with new body. DEC-104/108.",
        "allOf": [
          {
            "if": {
              "properties": {
                "deletedAt": {
                  "type": "string"
                }
              },
              "required": [
                "deletedAt"
              ]
            },
            "then": {
              "properties": {
                "content": {
                  "type": "null"
                },
                "contentState": {
                  "const": "deleted"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "contentState": {
                    "const": "unavailable_after_restore"
                  }
                },
                "required": [
                  "contentState"
                ]
              },
              "then": {
                "properties": {
                  "content": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "contentState": {
                    "const": "available"
                  }
                }
              }
            }
          }
        ]
      },
