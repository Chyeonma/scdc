{
  "openapi": "3.1.0",
  "info": {
    "title": "SCDC Direct Messaging — proposed contract",
    "version": "0.6.0-p1-inbox",
    "description": "GET search, POST mở DM và GET inbox đã được người dùng nghiệm thu; gửi tin, lịch sử và Hub chưa triển khai."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/users/search": {
      "get": {
        "operationId": "searchUsers",
        "summary": "Tìm người đủ điều kiện nhận DM; không trả email/chính người tìm",
        "tags": [
          "Identity user search"
        ],
        "responses": {
          "200": {
            "description": "Public projection chỉ id, username, displayName; trang rỗng là 200, nextCursor=null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSearchPage"
                }
              }
            }
          },
          "400": {
            "description": "Common.ValidationFailed cho q/limit/binding; CURSOR_INVALID cho cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Common.Unauthorized cho anonymous, actor/session/stamp không hợp lệ.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-scdc-implementation": "implemented-agent-tested-user-accepted",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "x-scdc-utf16-length": {
                "min": 2,
                "max": 64
              }
            },
            "description": "2–64 UTF-16 sau trim/NFC; case-insensitive theo .NET ToLowerInvariant, giữ dấu, literal %/_/backslash."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque encrypted/authenticated cursor, TTL 24h; bind actor/normalized q/limit. Cursor rỗng, hết hạn, sửa hoặc chéo scope: 400 CURSOR_INVALID."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": ""
          }
        ],
        "x-scdc-target-error-codes": {
          "400": [
            "Common.ValidationFailed",
            "CURSOR_INVALID"
          ],
          "401": [
            "Common.Unauthorized"
          ],
          "503": [
            "AUTHORITY_UNAVAILABLE"
          ]
        },
        "description": "Identity sở hữu query và guard actor/session. q trim/NFC/ToLowerInvariant, 2–64 UTF-16; substring literal, giữ dấu, không trả chính mình hoặc user chưa active/verified. Username exact trước rồi normalized username COLLATE C, UUID. Profile đổi giữa trang có thể đổi membership; refresh từ đầu. Cursor Data Protection 24h, giữ deadline của trang đầu, bind actor/q/limit; không chứa email/body."
      }
    },
    "/direct-conversations": {
      "post": {
        "operationId": "openDirectConversation",
        "summary": "Tạo hoặc lấy DM duy nhất của cặp",
        "tags": [
          "Direct messaging"
        ],
        "responses": {
          "200": {
            "description": "Create hoặc get đều 200 sau commit; đúng hai participant, UUIDv7 khi tạo mới; empty lastSequence=\"0\", lastActivityAt=null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectConversation"
                }
              }
            }
          },
          "400": {
            "description": "Common.ValidationFailed cho thiếu/null/UUID sai hoặc zero; INVALID_PEER cho self.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Common.Unauthorized cho actor/session/stamp/expiry không hợp lệ, kể cả guard recheck trong transaction.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND cho peer không tồn tại/không đủ điều kiện tạo mới hoặc membership/resource không hợp lệ; không tiết lộ lý do.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "AUTHORITY_UNAVAILABLE khi dependency PostgreSQL không xác nhận được request; fail closed, không auto replay.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-scdc-implementation": "implemented-agent-tested-user-accepted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenConversationRequest"
              }
            }
          }
        },
        "x-scdc-target-error-codes": {
          "400": [
            "Common.ValidationFailed",
            "INVALID_PEER"
          ],
          "401": [
            "Common.Unauthorized"
          ],
          "503": [
            "AUTHORITY_UNAVAILABLE"
          ],
          "404": [
            "RESOURCE_NOT_FOUND"
          ]
        },
        "x-scdc-acceptance-record": "docs/acceptance/direct-messaging/DM-P1-T02.md"
      },
      "get": {
        "operationId": "listDirectConversations",
        "summary": "Liệt kê DM của chính người gọi",
        "tags": [
          "Direct messaging"
        ],
        "responses": {
          "200": {
            "description": "Inbox của actor: lastActivityAt DESC NULLS LAST, ID ASC; chỉ membership active và space chưa xóa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationPage"
                }
              }
            }
          },
          "400": {
            "description": "Common.ValidationFailed cho limit không hợp lệ; CURSOR_INVALID cho cursor sai/hết hạn/chéo actor/limit.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Common.Unauthorized: cần actor active/verified và phiên hợp lệ; kiểm tra lại mỗi trang.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "AUTHORITY_UNAVAILABLE: không xác nhận được quyền hoặc dữ liệu; không trả inbox giả.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "x-scdc-implementation": "implemented-agent-tested-user-accepted",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Cursor Data Protection purpose Messaging.Conversations.v1, gắn actor/limit/scope direct-inbox và vị trí activity/ID; TTL 24h cố định kể từ trang đầu; chuỗi rỗng cũng bị từ chối. Dùng keyring persistent chung, purpose tách search."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "description": "Danh sách đang đổi vị trí theo lastActivityAt; client dedup ID và refresh trang đầu khi có tin mới. Không cam kết snapshot cố định xuyên trang.",
        "x-scdc-target-error-codes": {
          "400": [
            "Common.ValidationFailed",
            "CURSOR_INVALID"
          ],
          "401": [
            "Common.Unauthorized"
          ],
          "503": [
            "AUTHORITY_UNAVAILABLE"
          ]
        },
        "x-scdc-acceptance-record": "docs/acceptance/direct-messaging/DM-P1-T03.md"
      }
    },
