            },
            "description": "Người gọi phải là một trong hai người của hội thoại."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Con trỏ lịch sử; không kết hợp after/through."
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "resumeCursor/nextCursor được bảo vệ, hoặc sentinel 0; không là sequence tùy ý."
            },
            "description": "Con trỏ bù tin; through chốt ở lần đầu, giữ cho các trang sau."
          },
          {
            "name": "through",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "description": "Nếu có phải bằng H của protected after cursor; không dùng độc lập/before; đầu request bù mới để server chốt H."
            },
            "description": "Chỉ dùng với after; mốc sequence đã commit."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          }
        ],
        "description": "before/after là cursor protected; after=0 là sentinel bootstrap. Không trộn before+after. through chỉ kiểm tra H đã ký trong after cursor, không nhận frontier tùy ý. Response resumeCursor theo phần detailed-design."
      },
