              ],
              "format": "uuid"
            },
            "membershipId": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "enum": [
                "permission_changed",
                "membership_left",
                "channel_deleted",
                "session_revoked",
                "account_unavailable"
              ]
            }
          },
          "required": [
            "eventId",
            "serverId",
            "channelId",
            "membershipId",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    }
