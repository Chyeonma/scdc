          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "serverId": {
              "type": "string",
              "format": "uuid"
            },
            "channelId": {
              "type": "string",
              "format": "uuid"
            },
            "message": {
              "$ref": "./community.openapi.json#/components/schemas/ChannelMessage"
            }
          },
          "required": [
            "eventId",
            "serverId",
            "channelId",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "name": {
          "const": "CommunityChanged"
        },
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "serverId": {
              "type": "string",
              "format": "uuid"
            },
            "accessVersion": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "x-scdc-integer-max": "9223372036854775807"
            }
          },
          "required": [
            "eventId",
            "serverId",
            "accessVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
