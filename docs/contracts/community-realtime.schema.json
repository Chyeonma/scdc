    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "name": {
          "const": "MembershipChanged"
        },
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
