{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCDC Community application message catalogue — draft",
  "description": "Additional application messages on /hubs/chat alongside chat-realtime.schema.json; not SignalR wire frames. User notifications route by authorized user/session; no all-member broadcast for requests/invitations/roster. Relative refs resolve from this file.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "invoke"
        },
        "name": {
          "const": "SubscribeChannel"
        },
        "payload": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "format": "uuid"
            },
            "channelId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "serverId",
            "channelId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "invoke"
        },
        "name": {
          "const": "UnsubscribeChannel"
        },
        "payload": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "format": "uuid"
            },
            "channelId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "serverId",
            "channelId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "result"
        },
        "name": {
          "const": "ChannelSubscriptionAcknowledgement"
        },
        "payload": {
          "type": "object",
          "properties": {
            "serverId": {
              "type": "string",
              "format": "uuid"
            },
            "channelId": {
              "type": "string",
              "format": "uuid"
            },
            "subscribed": {
              "type": "boolean"
            }
          },
          "required": [
            "serverId",
            "channelId",
            "subscribed"
