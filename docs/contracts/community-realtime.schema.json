            "membershipId": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "left"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$",
              "x-scdc-integer-max": "9223372036854775807"
            }
          },
          "required": [
            "eventId",
            "serverId",
            "membershipId",
            "status",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "name": {
          "const": "JoinRequestChanged"
        },
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "request": {
              "$ref": "./community.openapi.json#/components/schemas/JoinRequest"
            }
          },
          "required": [
            "eventId",
            "request"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "name": {
          "const": "MemberInvitationChanged"
        },
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "invitation": {
              "$ref": "./community.openapi.json#/components/schemas/MemberInvitation"
            }
          },
          "required": [
            "eventId",
            "invitation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "name",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "name": {
          "const": "ChannelAccessRevoked"
        },
        "payload": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid"
