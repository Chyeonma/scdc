{
  "version": "0.1.0-draft",
  "description": "Design vectors only, not DB/worker/restore results. Exact UTC elapsed durations; kinds identify payload/fields/backup sets, not unconditional whole-row cascade. Access actorActive/peerActive assume verified eligible accounts and a valid actor session; they do not model JWT verification. Restore keep_current assumes recovered nondeleted body really matches its version; missing marker means unknown, not aborted. Record example hash/signature are placeholders, never authentication proof.",
  "decisions": [
    "DEC-103",
    "DEC-104",
    "DEC-105",
    "DEC-106",
    "DEC-107",
    "DEC-108",
    "DEC-109"
  ],
  "policy": {
    "daySeconds": 86400,
    "technicalLogDays": 14,
    "securityAuditDays": 90,
    "rawAuditClientDays": 7,
    "terminalDetailsDays": 7,
    "backupArtifactMaxAgeDays": 30,
    "backupMeans": "maximum_artifact_age",
    "liveMessageExpiryDays": null,
    "deletedChannelContentExpiryDays": null,
    "selfAccountDeleteInMvp": false,
    "retainDedupRevocationMarkers": true
  },
