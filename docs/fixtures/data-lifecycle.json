  "transitionScenarios": [
    {
      "id": "T01",
      "steps": [
        "prepared persisted",
        "DB rollback proven",
        "aborted persisted",
        "restore"
      ],
      "expected": "keep unchanged scope; do not apply intent"
    },
    {
      "id": "T02",
      "steps": [
        "prepared persisted",
        "DB commit",
        "independent receipt lost",
        "restore missing DB marker"
      ],
      "expected": "quarantine affected scope until outcome proved; do not auto-delete"
    },
    {
      "id": "T03",
      "steps": [
        "message delete committed and receipt durable",
        "restore older body",
        "replay twice"
      ],
      "expected": "content null, one tombstone, same floor, no duplicate message"
    },
    {
      "id": "T04",
      "steps": [
        "message edit floor 5",
        "restore version 3",
        "redact at version 5",
        "author writes fresh version 6",
        "replay floor 5"
      ],
      "expected": "fresh version 6 visible, no rollback to old body"
    },
    {
      "id": "T05",
      "steps": [
        "expired base at day 30",
        "newer verified base available",
        "catalogue dependency cleanup"
      ],
      "expected": "expire old backup set; keep WAL needed by newer valid base"
    },
    {
      "id": "T06",
      "steps": [
        "terminal outbox payload cleanup day 7",
        "repeat event ID"
      ],
      "expected": "dedup receipt denies second effect; payload cleanup is not receipt cleanup"
    }
  ]
}
