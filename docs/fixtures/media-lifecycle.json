  "transitionScenarios": [
    {
      "id": "L01",
      "name": "Two joins compete for final global slot",
      "given": {
        "globalOccupied": 19
      },
      "actions": [
        "join A",
        "join B"
      ],
      "expected": {
        "successfulAllocations": 1,
        "globalOccupied": 20
      }
    },
    {
      "id": "L02",
      "name": "Direct accept with only one global slot",
      "given": {
        "globalOccupied": 19,
        "callState": "ringing"
      },
      "actions": [
        "accept"
      ],
      "expected": {
        "newParticipations": 0,
        "globalOccupied": 19,
        "callState": "ringing"
      }
    },
    {
      "id": "L03",
      "name": "First accept wins across two devices",
      "given": {
        "callState": "ringing",
        "version": "1"
      },
      "actions": [
        "accept device A version 1",
        "accept device B version 1"
      ],
      "expected": {
        "newParticipations": 2,
        "winningBindings": 1,
        "loser": "version_conflict"
      }
    },
    {
      "id": "L04",
      "name": "Source stop without provider ack",
      "given": {
        "screenOccupied": 2
      },
      "actions": [
        "stop screen 1",
        "try screen 3"
      ],
      "expected": {
        "screenOccupied": 2,
        "newSource": "screen_full",
        "oldSource": "stopping"
      }
    },
    {
      "id": "L05",
      "name": "Reconnect deadline cannot be prolonged by heartbeat",
      "given": {
        "deadlineMs": 30000
      },
      "actions": [
        "heartbeat at 29000",
        "resume at 30000"
      ],
      "expected": {
        "deadlineMs": 30000,
        "participationState": "ended",
        "resume": "expired"
      }
    },
    {
      "id": "L06",
      "name": "Delayed provider event from old connection",
      "given": {
        "connectionEpoch": "2",
        "state": "connected"
      },
      "actions": [
        "disconnected event epoch 1"
      ],
      "expected": {
        "connectionEpoch": "2",
        "state": "connected",
        "observation": "ignored"
      }
    },
    {
      "id": "L07",
      "name": "Leave drains before capacity reuse",
      "given": {
        "globalOccupied": 20
      },
      "actions": [
        "leave without quiescence ack",
        "join new user",
        "provider quiescence ack",
        "join new user"
      ],
      "expected": {
        "firstJoin": "draining_or_full",
        "secondJoin": "allow",
        "globalOccupied": 20
      }
    },
    {
      "id": "L08",
      "name": "Old room after restore/restart",
      "given": {
        "roomGeneration": "2"
      },
      "actions": [
        "admit token generation 1"
      ],
      "expected": {
        "admission": "deny",
        "newParticipations": 0
      }
    }
  ],
