{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Modules": {
    "Identity": {
      "Schema": "identity",
      "Issuer": "SCDC",
      "Audience": "SCDC.WebClient",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "SessionDays": 30,
      "EmailVerificationTokenMinutes": 30,
      "PasswordResetTokenMinutes": 30,
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 15,
      "ExposeDevelopmentTokens": false
    },
    "Community": {
      "Schema": "community"
    },
    "Messaging": {
      "Schema": "messaging",
      "Attachments": {
        "Endpoint": "",
        "AccessKey": "",
        "SecretKey": "",
        "Bucket": "scdc-messaging",
        "ClamAvHost": "",
        "ClamAvPort": 3310
      },
      "Outbox": {
        "Enabled": true,
        "BatchSize": 20,
        "PollInterval": "00:00:01",
        "InitialRetryDelay": "00:00:01",
        "MaxRetryDelay": "00:05:00",
        "MaxAttempts": 10
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
