<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SCDC.Api</RootNamespace>
    <AssemblyName>SCDC.Api</AssemblyName>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SCDC.BuildingBlocks/SCDC.BuildingBlocks.csproj" />
    <ProjectReference Include="../SCDC.Contracts/SCDC.Contracts.csproj" />
    <ProjectReference Include="../Shared/SCDC.Shared.Core/SCDC.Shared.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.85.0" />
    <ProjectReference Include="../Identity/SCDC.Identity.Grpc/SCDC.Identity.Grpc.csproj" />
    <ProjectReference Include="../Community/SCDC.Community.Grpc/SCDC.Community.Grpc.csproj" />
    <ProjectReference Include="../Messaging/SCDC.Messaging.Grpc/SCDC.Messaging.Grpc.csproj" />
    <ProjectReference Include="../Community/SCDC.Community.Application/SCDC.Community.Application.csproj" />
    <ProjectReference Include="../Community/SCDC.Community.Infrastructure/SCDC.Community.Infrastructure.csproj" />
    <ProjectReference Include="../Messaging/SCDC.Messaging/SCDC.Messaging.csproj" />
  </ItemGroup>

  <!-- The legacy host keeps serving the same Community controllers until traffic moves. -->
  <ItemGroup>
    <Compile Include="../Community/SCDC.Community.Api/Controllers/Community/*.cs" Link="Controllers/Community/%(Filename)%(Extension)" />
    <Compile Include="../Community/SCDC.Community.Api/OpenApi/Community*.cs" Link="OpenApi/%(Filename)%(Extension)" />
    <Compile Include="../Community/SCDC.Community.Api/InternalRpc/CommunityIdentityFenceEndpoint.cs" Link="InternalRpc/CommunityIdentityFenceEndpoint.cs" />
  </ItemGroup>

</Project>
