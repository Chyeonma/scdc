  <ItemGroup>
    <ProjectReference Include="../SCDC.Sample.Application/SCDC.Sample.Application.csproj" />
    <ProjectReference Include="../SCDC.Sample.Infrastructure/SCDC.Sample.Infrastructure.csproj" />
